# Google Apps Script URL for form submissions (SERVER-ONLY)
# Do NOT prefix with NEXT_PUBLIC_ — this URL must not ship in the client bundle.
# The Next.js API route at /api/submit-contact reads this env var server-side.
# Get this URL from your Google Apps Script deployment.
# Instructions: See DEPLOYMENT.md
GOOGLE_SCRIPT_URL=your_google_apps_script_url_here
